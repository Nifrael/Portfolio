---
import Layout from "@layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Github from "@assets/icons/Github.svg";
import ExternalLink from "@assets/icons/ExternalLink.svg";
import TagList from "@components/ui/TagList.astro";
import ArrowLink from "@components/ui/ArrowLink.astro";
import CtaButton from "@components/ui/CtaButton.astro";
import CornerAccents from "@components/ui/CornerAccents.astro";
import { formatMonthYear } from "@utils/date";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, tags, cover, links, publishDate } = project.data;
const { Content } = await render(project);

const formattedDate = formatMonthYear(publishDate);
---

<Layout title={`${title} — NifraDev`} description={description}>
  <article class="project-detail-page">
    <div class="container">
      <header class="project-header">
        <nav class="breadcrumb" aria-label="Fil d'ariane">
          <ArrowLink href="/projets" direction="left" muted
            >Tous les projets</ArrowLink
          >
        </nav>

        <div class="title-section">
          <TagList tags={tags} />
          <h1 class="project-title">{title}</h1>
          <p class="project-meta">Réalisé en {formattedDate}</p>
        </div>
      </header>

      <div class="project-layout">
        <div class="project-main-content">
          <div class="hero-image-wrapper">
            <Image
              src={cover.src}
              alt={cover.alt}
              width={1200}
              height={675}
              class="hero-image"
              loading="eager"
              fetchpriority="high"
            />
            <CornerAccents />
          </div>

          <div class="markdown-content">
            <Content />
          </div>
        </div>

        <aside class="project-sidebar">
          <div class="sidebar-widget">
            <h2 class="widget-title">En résumé</h2>
            <p class="project-excerpt">{description}</p>

            {
              links && (
                <div class="project-actions">
                  {links.live && (
                    <CtaButton href={links.live} label="Démonstration" external>
                      <ExternalLink slot="icon" width={16} height={16} />
                    </CtaButton>
                  )}
                  {links.repository && (
                    <CtaButton
                      href={links.repository}
                      label="Code source"
                      variant="outline"
                      external
                    >
                      <Github slot="icon" width={16} height={16} />
                    </CtaButton>
                  )}
                </div>
              )
            }
          </div>

          <CornerAccents />
        </aside>
      </div>
    </div>
  </article>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .project-detail-page {
    position: relative;
    padding: 3rem 1.5rem;
    min-height: 100vh;
    overflow: hidden;
  }

  .container {
    position: relative;
    max-width: 80rem;
    margin: 0 auto;
    width: 100%;
    z-index: 10;
  }

  .project-header {
    margin-bottom: 4rem;
  }

  .breadcrumb {
    margin-bottom: 2rem;
  }

  .title-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-title {
    font-family: var(--font-title);
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 700;
    line-height: 0.95;
    font-style: italic;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.02em;
  }

  .project-meta {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text-primary);
    opacity: 0.6;
    margin: 0;
  }

  .project-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: 8fr 4fr;
      gap: 4rem;
    }
  }

  .hero-image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: rgba(255, 255, 255, 0.01);
    margin-bottom: 3rem;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  // :global() est requis : le HTML rendu par <Content /> ne porte pas
  // l'attribut de scope Astro, les sélecteurs scopés ne le matchent jamais.
  .markdown-content {
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.8;
    opacity: 0.85;

    :global(h2) {
      font-family: var(--font-title);
      font-size: 1.8rem;
      font-style: italic;
      color: var(--text-primary);
      margin: 3rem 0 1.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 0.5rem;
    }

    :global(h3) {
      font-family: var(--font-title);
      font-size: 1.3rem;
      font-style: italic;
      color: var(--accent-primary);
      margin: 2rem 0 1rem;
    }

    :global(p) {
      margin-bottom: 1.5rem;
    }

    :global(ul),
    :global(ol) {
      margin-bottom: 2rem;
      padding-left: 1.5rem;
    }

    :global(li) {
      margin-bottom: 0.5rem;
    }

    :global(code) {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 0.2rem 0.4rem;
      border-radius: 0.25rem;
      font-size: 0.9em;
    }
  }

  .project-sidebar {
    position: relative;
    align-self: start;
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    padding: 2.5rem;
  }

  .widget-title {
    font-family: var(--font-title);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--text-primary);
    margin: 0 0 1.5rem 0;
  }

  .project-excerpt {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-primary);
    opacity: 0.7;
    margin: 0 0 2.5rem 0;
  }

  .project-actions {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
