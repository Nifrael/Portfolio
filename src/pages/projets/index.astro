---
import Layout from "@layouts/Layout.astro";
import ProjectCard from "@components/ui/ProjectCard.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import ArrowLink from "@components/ui/ArrowLink.astro";
import { getSortedProjects } from "@utils/projects";

const sortedProjects = await getSortedProjects();
---

<Layout
  title="Mes projets — NifraDev"
  description="L'ensemble des travaux de Julien Marchand en architecture web et développement full-stack."
>
  <div class="projects-page">
    <div class="container">
      <header class="page-header">
        <ArrowLink href="/" direction="left" muted>Retour à l'accueil</ArrowLink
        >
        <SectionTitle as="h1" outline="MES" main="PROJETS" />
        <p class="page-subtitle">
          Découvrez l'ensemble de mes travaux en architecture web et
          développement full-stack.
        </p>
      </header>

      <div class="projects-grid">
        {sortedProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </div>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .projects-page {
    position: relative;
    padding-block: var(--espace-l-plus);
    min-height: 100vh;
  }

  .page-header {
    --title-size: clamp(2.5rem, 8vw, 5rem);

    margin-bottom: var(--espace-xl-plus);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--espace-m-plus);
  }

  .page-subtitle {
    color: var(--color-text);
    font-size: 1.1rem;
    font-family: var(--font-text);
    font-weight: 200;
    max-width: 35rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.8;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--espace-l-plus);

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }
</style>
