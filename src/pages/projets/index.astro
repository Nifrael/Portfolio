---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import ProjectIndexList from "@components/projects/ProjectIndexList.astro";
import ProjectStats from "@components/projects/ProjectStats.astro";
import { getSortedProjects } from "@utils/projects";

const sortedProjects = await getSortedProjects();
---

<Layout
  title="Mes projets — NifraDev"
  description="L'ensemble des travaux de Julien Marchand en architecture web et développement full-stack."
>
  <div class="projects-page container">
    <PageHeader outline="MES" main="PROJETS">
      Découvrez l'ensemble de mes travaux en architecture web et développement
      full-stack.
      <ProjectStats projects={sortedProjects} slot="aside" />
    </PageHeader>

    <ProjectIndexList projects={sortedProjects} priority />
  </div>
</Layout>

<style lang="scss">
  .projects-page {
    padding-block: var(--espace-l-plus) var(--espace-section);
    min-height: 100vh;
    min-height: 100svh;
  }
</style>
