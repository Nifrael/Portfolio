---
import Layout from "@layouts/Layout.astro";
import ProjectCard from "@components/ui/ProjectCard.astro";
import PageHeader from "@components/ui/PageHeader.astro";
import { getSortedProjects } from "@utils/projects";

const sortedProjects = await getSortedProjects();
---

<Layout
  title="Mes projets — NifraDev"
  description="L'ensemble des travaux de Julien Marchand en architecture web et développement full-stack."
>
  <div class="projects-page">
    <div class="container">
      <PageHeader outline="MES" main="PROJETS">
        Découvrez l'ensemble de mes travaux en architecture web et développement
        full-stack.
      </PageHeader>

      <div class="projects-grid">
        {sortedProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </div>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .projects-page {
    position: relative;
    padding-block: var(--espace-l-plus);
    min-height: 100vh;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--espace-l-plus);

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }
</style>
