---
import Layout from "@layouts/Layout.astro";
import ArrowLink from "@components/ui/ArrowLink.astro";
---

<Layout
  title="Page introuvable — NifraDev"
  description="La page demandée n'existe pas ou a été déplacée."
>
  <div class="not-found container">
    <h1 class="code">
      <span class="code-outline">4</span><span class="code-main">0</span><span
        class="code-outline">4</span
      >
    </h1>
    <p class="message">Cette page n'existe pas ou a été déplacée.</p>
    <ArrowLink href="/" direction="left" muted>Retour à l'accueil</ArrowLink>
  </div>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .not-found {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--espace-m-plus);
    padding-block: var(--espace-xl);
    text-align: center;
  }

  .code {
    font-family: var(--font-title);
    font-size: clamp(5rem, 20vw, 10rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .code-outline {
    -webkit-text-stroke: 1.5px var(--color-accent);
    color: transparent;
  }

  .code-main {
    @include text-gradient;
  }

  .message {
    font-family: var(--font-text);
    font-size: 1.1rem;
    font-weight: 200;
    color: var(--color-text);
    opacity: 0.8;
    margin: 0;
  }
</style>
