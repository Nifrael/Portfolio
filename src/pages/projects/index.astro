---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout>
  <div class="projects-page">
    <div class="backdrop" aria-hidden="true">
      <div class="grid"></div>
      <div class="glow"></div>
    </div>

    <div class="container">
      <header class="page-header">
        <a href="/" class="back-home-link">
          <span class="arrow">←</span> Retour à l'accueil
        </a>
        <h1 class="page-title">
          <span class="title-outline">MES</span>
          <span class="title-main">PROJETS</span>
        </h1>
        <p class="page-subtitle">
          Découvrez l'ensemble de mes travaux en architecture web et développement full-stack.
        </p>
      </header>

      <div class="projects-grid">
        {
          sortedProjects.map((project) => {
            const { title, description, tags, cover, links } = project.data;
            return (
              <article class="project-card">
                <div class="project-image-wrapper">
                  <Image
                    src={cover.src}
                    alt={cover.alt}
                    width={800}
                    height={450}
                    class="project-image"
                  />
                  <div class="project-image-overlay" />
                </div>

                <div class="project-info">
                  <div class="project-tags">
                    {tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>

                  <h2 class="project-card-title">{title}</h2>
                  <p class="project-description">{description}</p>

                  <div class="project-footer">
                    <a href={`/projects/${project.id}`} class="project-details-link">
                      Détails
                      <span class="arrow" aria-hidden="true">→</span>
                    </a>

                    {links && (
                      <div class="project-links">
                        {links.repository && (
                          <a
                            href={links.repository}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="project-icon-link"
                            aria-label={`Code source de ${title}`}
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="20"
                              height="20"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                              <path d="M9 18c-4.51 2-5-2-7-2" />
                            </svg>
                          </a>
                        )}
                        {links.live && (
                          <a
                            href={links.live}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="project-icon-link"
                            aria-label={`Démonstration en direct de ${title}`}
                          >
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="20"
                              height="20"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                              <polyline points="15 3 21 3 21 9" />
                              <line x1="10" y1="14" x2="21" y2="3" />
                            </svg>
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </div>

                <span class="corner corner-tr" aria-hidden="true" />
                <span class="corner corner-bl" aria-hidden="true" />
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</Layout>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .projects-page {
    position: relative;
    padding: 8rem 1.5rem 6rem;
    min-height: 100vh;
    overflow: hidden;

    @include breakpoint-up($breakpoint-desktop) {
      padding: 10rem 5rem 8rem;
    }
  }

  .backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .grid {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-size: 80px 80px;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  }

  .glow {
    position: absolute;
    top: -10%;
    right: -10%;
    width: 60%;
    height: 60%;
    border-radius: 50%;
    background: rgba(0, 229, 239, 0.02);
    filter: blur(150px);
  }

  .container {
    position: relative;
    max-width: 80rem;
    margin: 0 auto;
    width: 100%;
    z-index: 10;
  }

  .page-header {
    margin-bottom: 5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .back-home-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.6;
    transition: opacity 0.3s ease, color 0.3s ease;

    .arrow {
      transition: transform 0.3s ease;
    }

    &:hover {
      opacity: 1;
      color: var(--accent-primary);

      .arrow {
        transform: translateX(-4px);
      }
    }
  }

  .page-title {
    font-family: var(--font-title);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 0.9;
    font-style: italic;
    margin: 0;
    display: flex;
    flex-direction: column;
    letter-spacing: -0.02em;
  }

  .title-outline {
    -webkit-text-stroke: 1.5px var(--accent-primary);
    color: transparent;
  }

  .title-main {
    background: linear-gradient(to right, var(--text-primary), var(--accent-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }

  .page-subtitle {
    color: var(--text-primary);
    font-size: 1.1rem;
    font-family: var(--font-body);
    font-weight: 200;
    max-width: 35rem;
    line-height: 1.6;
    margin: 0;
    opacity: 0.8;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;

    @include breakpoint-up($breakpoint-tablet) {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  .project-card {
    position: relative;
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;

    &:hover {
      border-color: rgba(0, 229, 239, 0.3);
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0, 229, 239, 0.05);

      .project-image {
        transform: scale(1.03);
      }

      .project-image-overlay {
        opacity: 0.1;
      }
    }
  }

  .project-image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-image-overlay {
    position: absolute;
    inset: 0;
    background: var(--bg-base);
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  .project-info {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    background: rgba(0, 229, 239, 0.06);
    padding: 0.25rem 0.65rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(0, 229, 239, 0.1);
  }

  .project-card-title {
    font-family: var(--font-title);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
    letter-spacing: -0.01em;
  }

  .project-description {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-primary);
    opacity: 0.7;
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .project-details-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.3s ease;

    .arrow {
      transition: transform 0.3s ease;
    }

    &:hover {
      color: var(--accent-primary);

      .arrow {
        transform: translateX(4px);
      }
    }
  }

  .project-links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .project-icon-link {
    color: var(--text-primary);
    opacity: 0.6;
    transition: color 0.3s ease, opacity 0.3s ease, transform 0.2s ease;

    &:hover {
      color: var(--accent-primary);
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  // Corners
  .corner {
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    pointer-events: none;

    &-tr {
      top: -1px;
      right: -1px;
      border-top: 2px solid var(--text-primary);
      border-right: 2px solid var(--text-primary);
    }

    &-bl {
      bottom: -1px;
      left: -1px;
      border-bottom: 2px solid var(--text-primary);
      border-left: 2px solid var(--text-primary);
    }
  }
</style>
