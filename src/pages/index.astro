---
import Layout from "@layouts/Layout.astro";
import Hero from "@components/home/Hero.astro";
import Services from "@components/home/Services.astro";
import FeaturedProjects from "@components/home/FeaturedProjects.astro";
import Method from "@components/home/Method.astro";
import Proofs from "@components/home/Proofs.astro";
import ContactCta from "@components/home/ContactCta.astro";
import { getFeaturedProjects } from "@utils/projects";
import type { MethodStep, ProofStat, Service } from "@components/home/types";

const featuredProjects = await getFeaturedProjects();

const services: Service[] = [
  {
    shape: "triangle",
    titre: "Site vitrine sur mesure",
    texte:
      "Un site qui vous ressemble, rapide et lisible sur tous les écrans, pour présenter votre activité et donner envie de vous contacter.",
  },
  {
    shape: "circle",
    titre: "Refonte de site existant",
    texte:
      "Votre site est lent, daté ou difficile à lire sur mobile ? Je le reconstruis plus rapide, plus accessible et mieux référencé.",
  },
  {
    shape: "cross",
    titre: "Maintenance et évolutions",
    texte:
      "Une fois en ligne, votre site continue de vivre : mises à jour, nouveaux contenus, petites évolutions. Je m'en occupe, vous vous concentrez sur votre activité.",
  },
  {
    shape: "square",
    titre: "Un accompagnement clair",
    texte:
      "De la première discussion à la mise en ligne, je vous explique chaque choix simplement. Formateur au Wagon, la pédagogie fait partie de mon quotidien.",
  },
];

const methodSteps: MethodStep[] = [
  {
    titre: "Échange",
    texte:
      "On fait le point sur votre activité, vos besoins et votre budget, pour définir ensemble un projet réaliste.",
  },
  {
    titre: "Design",
    texte:
      "Vous avez déjà une maquette ou une charte graphique ? Je m'appuie dessus. Vous partez de zéro ? Je vous propose une base de design simple et soignée, à ajuster ensemble.",
  },
  {
    titre: "Développement",
    texte:
      "Je construis votre site en vous tenant informé à chaque étape, pour ajuster au fil de l'eau.",
  },
  {
    titre: "Mise en ligne",
    texte:
      "Votre nom de domaine reste à votre nom : je vous guide pour l'acheter, puis je m'occupe de l'hébergement, de sa connexion et de la mise en ligne.",
  },
];

// Chiffres arrondis à la baisse : site client le plus lourd (Lighthouse mobile,
// octobre 2026 : 807 Ko, 10 Ko de JS) contre la référence la plus basse du
// Web Almanac 2025 (page mobile médiane : 2 164 Ko, 632 Ko de JS).
const proofStats: ProofStat[] = [
  {
    valeur: "−60 %",
    label:
      "de poids par rapport à une page web typique : un site qui se charge vite, même en 4G",
  },
  {
    valeur: "−95 %",
    label:
      "de scripts à charger : une page qui réagit tout de suite, sans faire ramer le téléphone",
  },
];
const proofSource =
  "Mesures sur les sites clients livrés, comparées à la page mobile médiane du Web Almanac 2025 (HTTP Archive).";
---

<Layout
  fullBleed
  title="Julien Marchand — Développeur web full-stack | NifraDev"
  description="Portfolio de Julien Marchand, développeur web full-stack : projets et réalisations axés sur la performance, l'accessibilité et l'architecture web."
>
  <Hero />
  <Services services={services} />
  <FeaturedProjects projects={featuredProjects} />
  <Method steps={methodSteps} />
  <Proofs stats={proofStats} source={proofSource} />
  <ContactCta />
</Layout>
