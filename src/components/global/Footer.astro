---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <p class="footer-logo">
      NIFRA<span class="footer-accent">DEV</span>
    </p>

    <p class="footer-copy">
      &copy; {currentYear} NifraDev. Tous droits réservés.
    </p>
  </div>
</footer>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .footer {
    border-top: 1px solid var(--color-border);
    padding: var(--espace-l) var(--espace-m-plus);
    background: transparent;

    @include breakpoint-up($breakpoint-desktop) {
      padding: var(--espace-l);
    }
  }

  .footer-inner {
    max-width: var(--largeur-max-entete);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espace-m);

    @include breakpoint-up($breakpoint-tablet) {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-logo {
    margin-block: var(--espace-m);
    font-weight: 700;
    font-size: var(--base-size);
    letter-spacing: 0.15em;
    text-decoration: none;
    color: var(--color-text);
    transition: color 0.4s ease;

    @include breakpoint-up($breakpoint-desktop) {
      &:hover {
        color: var(--color-accent);
      }
    }
  }

  .footer-accent {
    color: var(--color-accent);
  }

  .footer-copy {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.03em;
  }
</style>
