---
const menuItems = [
  { href: "#/projets", label: "PROJETS" },
  { href: "#a-propos", label: "A PROPOS" },
  { href: "#contact", label: "CONTACT" },
];
---

<header class="navbar-wrapper">
  {
    /* Le <nav> englobe la barre ET le menu mobile : les lecteurs d'écran
       annoncent ainsi les deux comme navigation. La barre reste un <div>, car
       son backdrop-filter casserait le flou du menu mobile s'il y était imbriqué. */
  }
  <nav aria-label="Navigation principale">
    <div class="navbar">
      <a href="/" class="logo" aria-label="NifraDev, accueil">
        <div class="logo-icon">
          <span class="chevron">&gt;</span><span class="underscore">_</span>
        </div>
        <div class="logo-text">
          NIFRA<span class="underscore">DEV</span>
        </div>
      </a>

      <button
        class="menu-toggle"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="navbar-mobile"
        id="navbar-toggle"
      >
        <span class="hamburger" aria-hidden="true"></span>
      </button>

      <div class="nav-desktop">
        <ul class="menu-items">
          {
            menuItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="nav-mobile" id="navbar-mobile" aria-hidden="true">
      <ul class="menu-items">
        {
          menuItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  import { initNavbar } from "@scripts/navbar";
  initNavbar();
</script>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .navbar-wrapper {
    position: fixed;
    top: 1.5rem;
    width: 100%;
    padding-inline: var(--gouttiere);
    z-index: 100;
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--color-bg-surface);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    border: 1px solid var(--color-border);
    border-radius: var(--rayon-pilule);
    padding: var(--espace-s) var(--espace-m);
    margin: 0 auto;
    box-shadow: 0 4px 16px -3px var(--color-shadow);
    max-width: var(--largeur-max);

    @include breakpoint-up($breakpoint-tablet) {
      padding: var(--espace-s-plus) var(--espace-m) var(--espace-s-plus)
        var(--espace-m-plus);
    }
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--espace-m);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.4s ease;

    @include breakpoint-up($breakpoint-desktop) {
      &:hover {
        color: var(--color-accent);
      }
    }
  }

  .logo-text {
    font-weight: 700;
    font-size: var(--base-size);
    letter-spacing: 0.15em;

    .underscore {
      color: var(--color-accent);
    }

    @include breakpoint-up($breakpoint-desktop) {
      font-size: var(--p);
    }
  }

  .logo-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--rayon-rond);
    border: 1px solid var(--color-border-emphasis);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-text);
    font-size: var(--base-size);
    font-weight: 500;

    .chevron {
      color: var(--color-text-strong);
    }

    .underscore {
      color: var(--color-accent);
    }
  }

  .menu-toggle {
    appearance: none;
    -webkit-appearance: none;
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    cursor: pointer;

    @include breakpoint-up($breakpoint-tablet) {
      display: none;
    }
  }

  .hamburger {
    position: relative;
    width: 18px;
    height: 2px;
    background: var(--color-text);
    border-radius: var(--rayon-xs);
    transition: background-color 0.3s ease;

    &::before,
    &::after {
      content: "";
      position: absolute;
      left: 0;
      width: 18px;
      height: 2px;
      background: var(--color-text);
      border-radius: var(--rayon-xs);
      transition: transform 0.3s ease;
    }

    &::before {
      transform: translateY(-6px);
    }

    &::after {
      transform: translateY(6px);
    }

    &.is-active {
      background: transparent;

      &::before {
        transform: rotate(45deg);
      }

      &::after {
        transform: rotate(-45deg);
      }
    }
  }

  .nav-desktop {
    display: none;

    @include breakpoint-up($breakpoint-tablet) {
      display: flex;
      align-items: center;
      gap: var(--espace-l);
    }

    @include breakpoint-up($breakpoint-desktop) {
      gap: var(--espace-xl);
    }
  }

  .nav-mobile {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: calc(100% + 1rem);
    inset-inline: var(--gouttiere);
    background: var(--color-bg-surface);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    border: 1px solid var(--color-border);
    border-radius: var(--rayon-l);
    padding: var(--espace-l);
    gap: var(--espace-l);

    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0s linear 0.25s;

    &.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
      transition:
        opacity 0.25s ease,
        transform 0.25s ease,
        visibility 0s linear 0s;

      li {
        opacity: 0;
        transform: translateY(-6px);
        animation: navItemIn 0.3s ease forwards;

        @for $i from 1 through 5 {
          &:nth-child(#{$i}) {
            animation-delay: #{$i * 0.06}s;
          }
        }

        @media (prefers-reduced-motion: reduce) {
          opacity: 1;
          transform: none;
          animation: none;
        }
      }
    }

    @include breakpoint-up($breakpoint-tablet) {
      display: none;
    }
  }

  @keyframes navItemIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .menu-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--espace-m-plus);
    margin: 0;
    padding: 0;

    @include breakpoint-up($breakpoint-tablet) {
      flex-direction: row;
      gap: var(--espace-l);
      flex: 1;
      justify-content: center;
    }

    a {
      color: var(--color-text);
      text-decoration: none;
      font-family: var(--font-text);
      font-size: var(--base-size);
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      transition: color 0.4s ease;

      @include breakpoint-up($breakpoint-tablet) {
        &:hover {
          color: var(--color-accent);
        }
      }
    }
  }
</style>
