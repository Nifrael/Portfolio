---
import GlassSymbol from "@components/ui/GlassSymbol.astro";
---

<div class="symbols" aria-hidden="true">
  <GlassSymbol symbol="△" class="sym-triangle" />
  <GlassSymbol symbol="○" class="sym-circle" />
  <GlassSymbol symbol="×" class="sym-cross" />
  <GlassSymbol symbol="□" class="sym-square" />
</div>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      transform: translate(10px, -20px) rotate(2deg);
    }
    66% {
      transform: translate(-10px, 10px) rotate(-2deg);
    }
  }

  .symbols {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;

    :global(.sym-triangle) {
      position: absolute;
      top: -2rem;
      left: -4rem;
      width: 16rem;
      height: 16rem;
      transform: rotate(12deg);
      opacity: 0.35;
      animation: float 18s ease-in-out infinite;
      span {
        font-size: 7rem;
      }

      @include breakpoint-up($breakpoint-desktop) {
        width: 20rem;
        height: 20rem;
        left: -5rem;
        span {
          font-size: 9rem;
        }
      }
    }

    :global(.sym-circle) {
      position: absolute;
      top: 50%;
      right: -6rem;
      width: 18rem;
      height: 18rem;
      transform: translateY(-50%) rotate(-12deg);
      opacity: 0.25;
      animation: float 12s ease-in-out infinite;
      span {
        font-size: 10rem;
      }

      @include breakpoint-up($breakpoint-desktop) {
        width: 24rem;
        height: 24rem;
        right: -8rem;
        span {
          font-size: 12rem;
        }
      }
    }

    :global(.sym-cross) {
      position: absolute;
      bottom: -4rem;
      left: 25%;
      width: 12rem;
      height: 12rem;
      transform: rotate(45deg);
      opacity: 0.35;
      animation: float 8s ease-in-out infinite;
      span {
        font-size: 5rem;
      }

      @include breakpoint-up($breakpoint-desktop) {
        width: 16rem;
        height: 16rem;
        span {
          font-size: 8rem;
        }
      }
    }

    :global(.sym-square) {
      position: absolute;
      top: 5rem;
      right: 25%;
      width: 8rem;
      height: 8rem;
      transform: rotate(-6deg);
      opacity: 0.15;
      animation: float 12s ease-in-out infinite -4s;
      span {
        font-size: 4rem;
      }

      @include breakpoint-up($breakpoint-desktop) {
        width: 10rem;
        height: 10rem;
        span {
          font-size: 6rem;
        }
      }
    }
  }
</style>
