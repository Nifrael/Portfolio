---
import SectionTitle from "@components/ui/SectionTitle.astro";
import ShapeCardGrid from "@components/ui/ShapeCardGrid.astro";
import type { ShapeCard } from "./types";

/**
 * ShapeCards — Section de compétences : titre et grille de cartes à symboles.
 *
 * @prop {string} outline       - Ligne en contour du titre de section.
 * @prop {string} main          - Ligne en dégradé du titre de section.
 * @prop {ShapeCard[]} items    - Cartes à afficher.
 */
interface Props {
  outline: string;
  main: string;
  items: ShapeCard[];
}

const { outline, main, items } = Astro.props;
---

<section class="shape-cards container" aria-label={`${outline} ${main}`}>
  <SectionTitle outline={outline} main={main} class="shape-cards-title" />
  <ShapeCardGrid items={items} />
</section>

<style lang="scss">
  .shape-cards {
    padding-block: var(--espace-section);

    :global(.shape-cards-title) {
      margin-bottom: var(--espace-xl);
    }
  }
</style>
