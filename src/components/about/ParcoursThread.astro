---
import ScrollThread from "@components/ui/ScrollThread.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import ThreadNode from "@components/ui/ThreadNode.astro";
import type { ParcoursStep } from "./types";

/**
 * ParcoursThread — Parcours le long d'un fil néon qui se déroule au scroll.
 *
 * Fil ondulant (ScrollThread) qui recroise l'axe sur chaque nœud-symbole
 * (ThreadNode) : à gauche en mobile, au centre en desktop avec des cartes
 * alternées de part et d'autre.
 *
 * @prop {ParcoursStep[]} steps - Étapes, de la plus ancienne à la plus récente.
 */
interface Props {
  steps: ParcoursStep[];
}

const { steps } = Astro.props;
---

<section class="parcours container" aria-label="Parcours">
  <SectionTitle outline="MON" main="PARCOURS" class="parcours-title" />

  <ScrollThread waves={steps.length} class="parcours-thread">
    <ol class="steps" role="list">
      {
        steps.map((step) => (
          <li class="step">
            <ThreadNode shape={step.shape} class="node" />
            <article class="card">
              <p class="periode">{step.periode}</p>
              <h3 class="titre">{step.titre}</h3>
              <p class="lieu">{step.lieu}</p>
              <p class="texte">{step.texte}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </ScrollThread>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .parcours {
    --wire-width: 3rem;

    padding-block: var(--espace-section);

    @include breakpoint-up($breakpoint-desktop) {
      --wire-width: 6rem;
    }

    :global(.parcours-title) {
      margin-bottom: var(--espace-xl);
    }
  }

  // Fil plus épais : il ondule déjà beaucoup
  .parcours :global(.parcours-thread) {
    --thread-width: var(--wire-width);
    --thread-stroke: 3;

    @include breakpoint-up($breakpoint-desktop) {
      --thread-center: 50%;
    }
  }

  .steps {
    display: grid;
    gap: var(--espace-xl);
    padding-block: var(--espace-l);
  }

  .step {
    display: grid;
    grid-template-columns: var(--wire-width) 1fr;
    gap: var(--espace-m);
    align-items: center;

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: 1fr var(--wire-width) 1fr;
      gap: var(--espace-l-plus);
    }

    :global(.node) {
      --symbol-size: 1.25rem;

      grid-row: 1;
      grid-column: 1;
      justify-self: center;

      @include breakpoint-up($breakpoint-desktop) {
        grid-column: 2;
      }
    }
  }

  .card {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--espace-s);
    padding: var(--espace-l);
    border: 1px solid var(--color-border);
    background: var(--color-bg-cards);
    backdrop-filter: blur(12px);

    @include breakpoint-up($breakpoint-desktop) {
      grid-column: 1;
      align-items: flex-end;
      text-align: right;

      .step:nth-child(even) & {
        grid-column: 3;
        align-items: flex-start;
        text-align: left;
      }
    }
  }

  .periode {
    font-size: var(--little-text);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .titre {
    font-family: var(--font-title);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-strong);
  }

  .lieu {
    font-size: var(--little-text);
    color: var(--color-text-secondary);
  }

  .texte {
    max-width: 30rem;
    margin-top: var(--espace-s);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
    opacity: 0.8;
  }

  @keyframes card-reveal {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .card {
        animation: card-reveal ease-out both;
        animation-timeline: view();
        animation-range: entry 10% cover 30%;
      }
    }
  }
</style>
