---
import SectionTitle from "@components/ui/SectionTitle.astro";
import ShapeSymbol from "@components/ui/ShapeSymbol.astro";
import type { ParcoursStep } from "./types";

/**
 * ParcoursThread — Parcours le long d'un fil néon qui se déroule au scroll.
 *
 * CSS pur : le fil lumineux est révélé par un clip-path piloté par une
 * view-timeline (`--parcours`), calée pour que sa pointe suive le milieu de
 * l'écran ; chaque nœud s'allume quand la pointe l'atteint. Sans support des
 * scroll-driven animations (ou en mouvement réduit), tout est affiché allumé.
 *
 * @prop {ParcoursStep[]} steps - Étapes, de la plus ancienne à la plus récente.
 */
interface Props {
  steps: ParcoursStep[];
}

const { steps } = Astro.props;

// Fil ondulant autour de l'axe : deux demi-ondes par étape, il recroise
// l'axe (x = 50) au milieu de chaque étape, là où est posé le nœud.
const halfWaves = steps.length * 2;
const waveHeight = 1000 / halfWaves;
const wirePath = [
  "M 50 0",
  ...Array.from({ length: halfWaves }, (_, i) => {
    const y = i * waveHeight;
    const x = i % 2 === 0 ? 85 : 15;
    return `C ${x} ${y + waveHeight * 0.35}, ${x} ${y + waveHeight * 0.65}, 50 ${y + waveHeight}`;
  }),
].join(" ");
---

<section class="parcours container" aria-label="Parcours">
  <SectionTitle outline="MON" main="PARCOURS" class="parcours-title" />

  <div class="thread">
    <svg
      class="wire wire-track"
      viewBox="0 0 100 1000"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d={wirePath} vector-effect="non-scaling-stroke" />
    </svg>
    <svg
      class="wire wire-light"
      viewBox="0 0 100 1000"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d={wirePath} vector-effect="non-scaling-stroke" />
    </svg>

    <ol class="steps" role="list">
      {
        steps.map((step) => (
          <li class="step">
            <ShapeSymbol shape={step.shape} class="node" />
            <article class="card">
              <p class="periode">{step.periode}</p>
              <h3 class="titre">{step.titre}</h3>
              <p class="lieu">{step.lieu}</p>
              <p class="texte">{step.texte}</p>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .parcours {
    --wire-width: 3rem;

    padding-block: var(--espace-section);

    @include breakpoint-up($breakpoint-desktop) {
      --wire-width: 6rem;
    }

    :global(.parcours-title) {
      margin-bottom: var(--espace-xl);
    }
  }

  .thread {
    position: relative;
    view-timeline-name: --parcours;
  }

  // Le fil occupe la colonne des nœuds : à gauche en mobile, au centre en desktop
  .wire {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--wire-width);
    height: 100%;
    overflow: visible;
    fill: none;
    pointer-events: none;

    @include breakpoint-up($breakpoint-desktop) {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .wire-track {
    stroke: var(--color-border-emphasis);
    stroke-width: 1;
  }

  .wire-light {
    stroke: var(--color-text);
    stroke-width: 3;
  }

  .steps {
    display: grid;
    gap: var(--espace-xl);
    padding-block: var(--espace-l);
  }

  .step {
    display: grid;
    grid-template-columns: var(--wire-width) 1fr;
    gap: var(--espace-m);
    align-items: center;

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: 1fr var(--wire-width) 1fr;
      gap: var(--espace-l-plus);
    }

    // Nœud posé sur le fil : son fond masque le croisement
    :global(.node) {
      --symbol-size: 1.25rem;

      position: relative;
      grid-row: 1;
      grid-column: 1;
      justify-self: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--color-accent-border);
      border-radius: var(--rayon-rond);
      background: var(--color-bg-primary);
      color: var(--color-accent);
      filter: drop-shadow(0 0 6px var(--color-accent));

      @include breakpoint-up($breakpoint-desktop) {
        grid-column: 2;
      }
    }
  }

  .card {
    grid-row: 1;
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: var(--espace-s);
    padding: var(--espace-l);
    border: 1px solid var(--color-border);
    background: var(--color-bg-cards);
    backdrop-filter: blur(12px);

    @include breakpoint-up($breakpoint-desktop) {
      grid-column: 1;
      align-items: flex-end;
      text-align: right;

      .step:nth-child(even) & {
        grid-column: 3;
        align-items: flex-start;
        text-align: left;
      }
    }
  }

  .periode {
    font-size: var(--little-text);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .titre {
    font-family: var(--font-title);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-strong);
  }

  .lieu {
    font-size: var(--little-text);
    color: var(--color-text-secondary);
  }

  .texte {
    max-width: 30rem;
    margin-top: var(--espace-s);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
    opacity: 0.8;
  }

  @keyframes wire-unroll {
    from {
      clip-path: inset(0 -50% 100% -50%);
    }
    to {
      clip-path: inset(0 -50% 0 -50%);
    }
  }

  @keyframes node-on {
    from {
      color: var(--color-decor-symbol);
      border-color: var(--color-border);
      filter: none;
    }
  }

  @keyframes card-reveal {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      // Pointe du fil au milieu de l'écran : la révélation commence quand le
      // haut du fil atteint le milieu, et finit quand le bas l'atteint.
      .wire-light {
        animation: wire-unroll linear both;
        animation-timeline: --parcours;
        animation-range: cover 50vh cover calc(100% - 50vh);
      }

      .step :global(.node) {
        animation: node-on linear both;
        animation-timeline: view();
        animation-range: cover calc(50vh - 1.375rem) cover 50vh;
      }

      .card {
        animation: card-reveal ease-out both;
        animation-timeline: view();
        animation-range: entry 10% cover 30%;
      }
    }
  }
</style>
