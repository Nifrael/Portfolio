---
import Julien from "@assets/images/Julien.jpg";
import ArrowLink from "@components/ui/ArrowLink.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import AvailabilityBadge from "@components/ui/AvailabilityBadge.astro";
import NeonFrame from "@components/ui/NeonFrame.astro";

/**
 * AboutIntro — Ouverture de la page À propos : titre, disponibilité, texte de
 * présentation et portrait découpé en cercle néon (NeonFrame, comme les
 * visuels de projets).
 *
 * @prop {string[]} paragraphs - Paragraphes de présentation (le premier en chapô).
 */
interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
---

<section class="intro container" aria-label="Présentation">
  <div class="text">
    <ArrowLink href="/" direction="left" muted>Retour à l'accueil</ArrowLink>
    <SectionTitle as="h1" outline="QUI" main="SUIS-JE ?" />
    <AvailabilityBadge status="available" />
    {paragraphs.map((paragraph) => <p class="paragraph">{paragraph}</p>)}
  </div>

  <div class="portrait">
    <NeonFrame
      src={Julien}
      alt="Photo de Julien Marchand"
      shape="circle"
      size={600}
      sizes="22rem"
      loading="eager"
      class="frame"
    />
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .intro {
    --title-size: clamp(2.5rem, 8vw, 5rem);

    display: grid;
    gap: var(--espace-xl);
    align-items: center;
    padding-block: var(--espace-l-plus) var(--espace-section);

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: 3fr 2fr;
      min-height: calc(100vh - var(--navbar-offset-desktop));
      min-height: calc(100svh - var(--navbar-offset-desktop));
    }
  }

  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--espace-m-plus);
  }

  .paragraph {
    max-width: 38rem;
    font-size: 1rem;
    font-weight: 200;
    line-height: 1.7;
    color: var(--color-text);
    opacity: 0.8;

    &:first-of-type {
      font-size: 1.2rem;
      opacity: 1;
    }
  }

  .portrait {
    display: flex;
    justify-content: center;
  }

  .portrait :global(.frame) {
    width: min(100%, 22rem);
  }
</style>
