---
import HeroPortrait from "./HeroPortrait.astro";
import AvailabilityBadge from "@components/ui/AvailabilityBadge.astro";
import CtaButton from "@components/ui/CtaButton.astro";
---

<section class="hero" aria-label="Introduction">
  <div class="content container">
    <div class="text-side">
      <div class="title-block">
        <h1 class="name">
          <span class="name-main">JULIEN</span>
          <span class="name-outline">MARCHAND</span>
        </h1>

        <p class="subtitle">
          Développeur web <em class="highlight">full-stack</em>.
        </p>
      </div>

      <!-- <AvailabilityBadge status="available" /> -->
    </div>
    <div class="portrait-area">
      <HeroPortrait />
    </div>
    <div class="actions">
      <CtaButton href="/#projets" label="Projets" />
      <CtaButton href="/#contact" label="Me contacter" />
    </div>
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
    padding-block: var(--espace-xxl) var(--espace-l);

    @include breakpoint-up($breakpoint-desktop) {
      padding-block: 10rem var(--espace-m);
    }

    @include breakpoint-up($breakpoint-desktop-xl) {
      padding-block: 8rem var(--espace-m);
    }
  }

  .content {
    display: grid;
    grid-template-rows: 30% 55% 15%;
    align-items: center;
    position: relative;
    min-height: 70vh;
    z-index: 10;

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: 1fr 2fr;
      // Rows au contenu : les actions restent collées sous le bloc texte,
      // l'ensemble est centré verticalement dans le hero.
      grid-template-rows: auto auto;
      align-content: center;
    }
  }

  .title-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--espace-s);
  }

  .name {
    font-size: clamp(3rem, 15vw, 8rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    font-style: italic;
    margin: 0 auto;
    @include breakpoint-up($breakpoint-desktop) {
      font-size: clamp(1rem, 9vw, 8rem);
    }
  }

  .name-main {
    @include text-gradient;
  }

  .name-outline {
    -webkit-text-stroke: 1.5px var(--color-accent);
    color: transparent;
    display: inline-block;
    margin-top: calc(var(--espace-s) * -1);

    @include breakpoint-up($breakpoint-desktop) {
      margin-top: calc(var(--espace-m) * -1);
    }
  }

  .subtitle {
    margin-block: var(--espace-m);
    font-size: var(--base-size);
    font-weight: 200;
  }

  .highlight {
    color: var(--color-accent);
  }

  .actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    gap: var(--espace-l);
    margin-top: var(--espace-l);

    @include breakpoint-up($breakpoint-tablet) {
      gap: var(--espace-l-plus);
    }

    @include breakpoint-up($breakpoint-desktop) {
      grid-column: 1;
      align-self: start;
    }
  }

  .portrait-area {
    display: flex;
    align-items: center;
    justify-content: center;

    @include breakpoint-up($breakpoint-desktop) {
      grid-column: 2;
      grid-row: 1 / -1;
    }
  }
</style>
