---
import HeroBackdrop from "./HeroBackdrop.astro";
import HeroSymbols from "./HeroSymbols.astro";
import HeroPortrait from "./HeroPortrait.astro";
import AvailabilityBadge from "@components/ui/AvailabilityBadge.astro";
import CtaButton from "@components/ui/CtaButton.astro";
---

<section class="hero" aria-label="Introduction">
  <HeroBackdrop />
  <HeroSymbols />

  <div class="content">
    <div class="text-side">
      <div class="title-block">
        <h1 class="name">
          <span class="name-main">JULIEN</span>
          <span class="name-outline">MARCHAND</span>
        </h1>

        <p class="subtitle">
          Développeur web <em class="highlight">full-stack</em>.
        </p>
      </div>

      <AvailabilityBadge status="available" />

      <div class="actions">
        <CtaButton href="#projets" label="Projets" />
        <CtaButton href="#projets" label="Mon Parcours" />
      </div>
    </div>
    <HeroPortrait />
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
    padding: 6rem 1.5rem 4rem;

    @include breakpoint-up($breakpoint-desktop) {
      padding: 10rem 3rem 4rem;
    }

    @include breakpoint-up($breakpoint-desktop-xl) {
      padding: 8rem 2rem 4rem;
    }
  }

  .content {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr 1fr;
    justify-content: center;
    align-items: center;
    position: relative;
    min-height: 70vh;
    z-index: 10;
    max-width: 80rem;
    margin: 0 auto;
    width: 100%;

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: 1fr 2fr;
      grid-template-rows: 1fr;
    }
  }

  .title-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .name {
    font-family: var(--font-title);
    font-size: clamp(1rem, 9vw, 8rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.03em;
    font-style: italic;
    margin: 0 auto;
  }

  .name-main {
    background: linear-gradient(
      to right,
      var(--text-primary),
      var(--accent-primary)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    padding-right: 0.3em;
  }

  .name-outline {
    -webkit-text-stroke: 1.5px var(--accent-primary);
    color: transparent;
    display: inline-block;
    margin-top: -0.5rem;

    @include breakpoint-up($breakpoint-desktop) {
      margin-top: -1rem;
    }
  }

  .subtitle {
    color: var(--text-primary);
    font-size: 1rem;
    font-family: var(--font-body);
    font-weight: 200;
    line-height: 1.5;
  }

  .highlight {
    color: var(--accent-primary);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    margin-top: 4rem;

    @include breakpoint-up($breakpoint-tablet) {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }

    @include breakpoint-up($breakpoint-desktop) {
      margin-top: 2rem;
    }
  }
</style>
