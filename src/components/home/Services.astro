---
import SectionHeader from "@components/ui/SectionHeader.astro";
import ShapeCardGrid from "@components/ui/ShapeCardGrid.astro";
import type { Service } from "./types";

/**
 * Services — Ce que je propose, un service par symbole (△ ○ × □).
 *
 * @prop {Service[]} services - Services à afficher (fournis par la page).
 */
interface Props {
  services: Service[];
}

const { services } = Astro.props;
---

<section class="services container" id="services" aria-label="Services">
  <SectionHeader outline="CE QUE JE" main="PROPOSE">
    Des sites à taille humaine pour les indépendants et les petites structures :
    rapides, accessibles, et pensés pour durer.
  </SectionHeader>
  <ShapeCardGrid items={services} />
</section>

<style lang="scss">
  .services {
    padding-block: var(--espace-section);
    scroll-margin-top: var(--navbar-offset);
  }
</style>
