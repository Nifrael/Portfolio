---
import TagList from "@components/ui/TagList.astro";
import ArrowLink from "@components/ui/ArrowLink.astro";
import ProjectLinks from "@components/ui/ProjectLinks.astro";
import NeonFrame from "@components/ui/NeonFrame.astro";
import type { Project } from "@utils/projects";
import type { ProjectShape } from "../../content.config";

/**
 * FeaturedProject — Vitrine éditoriale d'un projet featured, dont le visuel
 * est associé à l'un des quatre symboles du site (△ ○ × □).
 *
 * Le visuel (NeonFrame) découpe le screenshot selon le symbole ; ce
 * composant gère sa taille, compensée selon la forme, et la mise en page.
 *
 * @prop {Project} project        - Projet à afficher.
 * @prop {ProjectShape} shape     - Symbole associé.
 * @prop {boolean} [reverse]      - Inverse visuel/texte en desktop (zigzag).
 */
interface Props {
  project: Project;
  shape: ProjectShape;
  reverse?: boolean;
}

const { project, shape, reverse = false } = Astro.props;
const { title, description, tags, cover, featuredCover, links } = project.data;
const visual = featuredCover ?? cover;
---

<article class:list={["featured-project", { reverse }]}>
  <div class="visual">
    <NeonFrame
      src={visual.src}
      alt={visual.alt}
      shape={shape}
      size={800}
      sizes="(min-width: 1024px) 24rem, 20rem"
      class="frame"
    />
  </div>

  <div class="details">
    <TagList tags={tags} />
    <h3 class="title">{title}</h3>
    <p class="description">{description}</p>
    <div class="details-footer">
      <ArrowLink href={`/projets/${project.id}`}>Détails</ArrowLink>
      <ProjectLinks links={links} title={title} />
    </div>
  </div>
</article>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .featured-project {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    width: 100%;
    max-width: 62rem;
    margin-inline: auto;

    @include breakpoint-up($breakpoint-desktop) {
      grid-template-columns: 1fr 1fr;
      gap: var(--espace-xl);

      &.reverse {
        .visual {
          order: 2;
        }

        .details {
          order: 1;
        }
      }
    }
  }

  .visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual :global(.frame) {
    width: min(100%, 18rem * var(--frame-scale, 1));
    transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);

    @include breakpoint-up($breakpoint-desktop) {
      width: min(100%, 21rem * var(--frame-scale, 1));

      &:hover {
        transform: scale(1.02);
      }
    }
  }

  .details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .title {
    font-family: var(--font-title);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0;
  }

  .description {
    @include body-muted(0.7);

    font-family: var(--font-text);
    max-width: 34rem;
    margin: 0;
  }

  .details-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 34rem;
    margin-top: var(--espace-s-plus);
  }

  .featured-project {
    @include scroll-reveal(entry 10% cover 35%);
  }
</style>
