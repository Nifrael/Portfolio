---
import ProjectCard from "@components/ui/ProjectCard.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import CtaButton from "@components/ui/CtaButton.astro";
import type { Project } from "@utils/projects";

/**
 * FeaturedProjects — Section des projets mis en avant sur la page d'accueil.
 *
 * @prop {Project[]} projects - Projets à afficher (fournis par la page).
 */
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section class="featured-projects" id="projets" aria-label="Projets phares">
  <div class="section-header">
    <SectionTitle outline="QUELQUES" main="PROJETS" class="reveal-title" />
    <p class="section-subtitle">
      Sélection de réalisations techniques axées sur la performance et
      l'architecture logicielle.
    </p>
  </div>

  <div class="projects-grid">
    {projects.map((project) => <ProjectCard project={project} featured={true} />)}
  </div>

  <div class="all-projects">
    <CtaButton
      href="/projects"
      label="Voir tous les projets"
      variant="outline"
      arrow
    />
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .featured-projects {
    position: relative;
    padding: 3rem 1.5rem;
    background: transparent;
    max-width: 95%;
    margin: 0 auto;

    @include breakpoint-up($breakpoint-desktop) {
      padding: 6rem 5rem;
    }
  }

  .section-header {
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;

    @include breakpoint-up($breakpoint-tablet) {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 3rem;
    }
  }

  .section-subtitle {
    color: var(--text-primary);
    font-size: 1rem;
    font-family: var(--font-body);
    font-weight: 200;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .all-projects {
    display: flex;
    justify-content: center;
    margin-top: 5rem;
  }

  @keyframes reveal-blur {
    from {
      opacity: 0;
      filter: blur(15px);
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  @supports (animation-timeline: view()) {
    // :global() requis : la classe est portée par le composant enfant
    // SectionTitle, qui ne reçoit pas l'attribut de scope de ce composant.
    .section-header :global(.reveal-title) {
      animation: reveal-blur both;
      animation-timeline: view();
      animation-range: entry 10% cover 40%;
    }

    .section-subtitle {
      animation: reveal-blur both;
      animation-timeline: view();
      animation-range: entry 15% cover 45%;
    }
  }
</style>
