---
import FeaturedProject from "@components/home/FeaturedProject.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import CtaButton from "@components/ui/CtaButton.astro";
import type { Project } from "@utils/projects";
import { PROJECT_SHAPES } from "../../content.config";

/**
 * FeaturedProjects — Section des projets mis en avant sur la page d'accueil.
 * Chaque projet est associé à un symbole (frontmatter `shape`, sinon cycle
 * △ ○ × □ selon sa position), en alternance visuel/texte.
 *
 * @prop {Project[]} projects - Projets à afficher (fournis par la page).
 */
interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section
  class="featured-projects container"
  id="projets"
  aria-label="Projets phares"
>
  <SectionHeader outline="QUELQUES" main="PROJETS">
    Sélection de réalisations techniques axées sur la performance et
    l'architecture logicielle.
  </SectionHeader>

  <div class="projects-showcase">
    {
      projects.map((project, index) => (
        <FeaturedProject
          project={project}
          shape={
            project.data.shape ?? PROJECT_SHAPES[index % PROJECT_SHAPES.length]
          }
          reverse={index % 2 === 1}
        />
      ))
    }
  </div>

  <div class="all-projects">
    <CtaButton
      href="/projets"
      label="Voir tous les projets"
      variant="outline"
      arrow
    />
  </div>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .featured-projects {
    position: relative;
    padding-block: var(--espace-section);
    background: transparent;
    scroll-margin-top: var(--navbar-offset);

    @include breakpoint-up($breakpoint-tablet) {
      --header-gap: 8rem;
    }
  }

  .projects-showcase {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--espace-xl);

    @include breakpoint-up($breakpoint-desktop) {
      gap: var(--espace-xl-plus);
    }
  }

  .all-projects {
    display: flex;
    justify-content: center;
    margin-top: var(--espace-xl-plus);
  }
</style>
