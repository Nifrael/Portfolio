---
import ScrollThread from "@components/ui/ScrollThread.astro";
import SectionTitle from "@components/ui/SectionTitle.astro";
import ThreadNode from "@components/ui/ThreadNode.astro";
import type { MethodStep } from "./types";

/**
 * Method — Étapes de travail avec le client, le long d'un fil lumineux.
 *
 * Fil droit (ScrollThread) passant par le centre des nœuds numérotés
 * (ThreadNode), à gauche des étapes.
 *
 * @prop {MethodStep[]} steps - Étapes, dans l'ordre (fournies par la page).
 */
interface Props {
  steps: MethodStep[];
}

const { steps } = Astro.props;
---

<section class="method container" id="methode" aria-label="Méthode de travail">
  <SectionTitle outline="COMMENT ON" main="TRAVAILLE" class="method-title" />

  <ScrollThread class="method-thread">
    <ol class="steps" role="list">
      {
        steps.map((step, index) => (
          <li class="step">
            <ThreadNode>{String(index + 1).padStart(2, "0")}</ThreadNode>
            <div class="content">
              <h3 class="titre">{step.titre}</h3>
              <p class="texte">{step.texte}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </ScrollThread>
</section>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .method {
    --node-size: 2.75rem;

    padding-block: var(--espace-section);
    scroll-margin-top: var(--navbar-offset);

    :global(.method-title) {
      margin-bottom: var(--espace-xl);
    }
  }

  // Le fil part du centre du premier nœud
  .method :global(.method-thread) {
    --thread-width: var(--node-size);
    --thread-start: calc(var(--node-size) / 2);

    max-width: 48rem;
    margin-inline: auto;
  }

  .steps {
    display: grid;
    gap: var(--espace-xl);
  }

  .step {
    display: grid;
    grid-template-columns: var(--node-size) 1fr;
    gap: var(--espace-m);
    align-items: start;

    @include breakpoint-up($breakpoint-tablet) {
      gap: var(--espace-l);
    }
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--espace-s);
    // Aligne la première ligne du titre sur le centre du nœud
    padding-top: calc(var(--node-size) / 2 - 0.85rem);
  }

  .titre {
    font-family: var(--font-title);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-text-strong);
  }

  .texte {
    max-width: 36rem;
    @include body-muted;
  }

  .content {
    @include scroll-reveal;
  }
</style>
