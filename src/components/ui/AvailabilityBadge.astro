---
/**
 * AvailabilityBadge — Badge animé indiquant un statut (disponibilité, site
 * en ligne…) : point vert pulsant si actif, rouge sinon.
 *
 * @prop {"available" | "unavailable"} [status="available"] - Statut affiché.
 * @prop {string} [label] - Libellé (défaut : « Disponible » / « Indisponible »).
 * @prop {string} [class] - Classes CSS additionnelles.
 */
interface Props {
  status?: "available" | "unavailable";
  label?: string;
  class?: string;
}

const { status = "available", label, class: className } = Astro.props;

const labelMap: Record<NonNullable<Props["status"]>, string> = {
  available: "Disponible",
  unavailable: "Indisponible",
};
---

<div class:list={["badge", `badge--${status}`, className]}>
  <span class="badge-dot">
    {status === "available" && <span class="badge-ping" />}
    <span class="badge-core"></span>
  </span>
  <span class="badge-text">{label ?? labelMap[status]}</span>
</div>

<style lang="scss">
  @keyframes ping {
    75%,
    100% {
      transform: scale(2);
      opacity: 0;
    }
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-s-plus);
    padding: 0.375rem var(--espace-m);
    border-radius: var(--rayon-m);
    backdrop-filter: blur(12px);
    width: fit-content;
  }

  .badge-dot {
    position: relative;
    display: flex;
    width: 0.5rem;
    height: 0.5rem;
  }

  .badge-ping,
  .badge-core {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--rayon-rond);
  }

  .badge--available .badge-ping,
  .badge--available .badge-core {
    background: var(--color-success);
  }

  .badge--unavailable .badge-core {
    background: var(--color-error);
  }

  .badge-ping {
    position: absolute;
    inset: 0;
    opacity: 0.75;
    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;

    // L'onde n'existe que par son animation : seul le point reste.
    @media (prefers-reduced-motion: reduce) {
      display: none;
    }
  }

  .badge-core {
    position: relative;
    display: inline-flex;
  }

  .badge-text {
    font-family: var(--font-text);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.3em;
  }
</style>
