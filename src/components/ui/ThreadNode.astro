---
import type { ProjectShape } from "../../content.config";
import ShapeSymbol from "./ShapeSymbol.astro";

/**
 * ThreadNode — Nœud rond posé sur un fil (ScrollThread, frise…). Par défaut,
 * il s'allume quand la pointe du fil (milieu de l'écran) l'atteint.
 *
 * Contient soit l'un des quatre symboles (`shape`), soit un court texte
 * (`label`, ex. un numéro d'étape). Décoratif : masqué aux lecteurs d'écran,
 * et le texte est généré en CSS pour ne pas compter comme du contenu.
 * La taille se règle via `--node-size` (défaut : 2.75rem), celle du symbole
 * via `--symbol-size` ; le placement est laissé au parent.
 *
 * @prop {ProjectShape} [shape]         - Symbole à afficher.
 * @prop {string} [label]               - Court texte, si pas de symbole.
 * @prop {"scroll" | "always"} [lit]    - Allumé au passage du fil (défaut)
 *                                        ou en permanence (fil non vertical).
 * @prop {string} [class]               - Classes CSS additionnelles.
 */
interface Props {
  shape?: ProjectShape;
  label?: string;
  lit?: "scroll" | "always";
  class?: string;
}

const { shape, label, lit = "scroll", class: className } = Astro.props;
---

<span
  class:list={["thread-node", { "lit-always": lit === "always" }, className]}
  data-label={label}
  aria-hidden="true"
>
  {shape && <ShapeSymbol shape={shape} class="thread-node-shape" />}
</span>

<style lang="scss">
  // Son fond masque le rail : le fil semble passer derrière le nœud
  .thread-node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node-size, 2.75rem);
    height: var(--node-size, 2.75rem);
    border: 1px solid var(--color-accent-border);
    border-radius: var(--rayon-rond);
    background: var(--color-bg-primary);
    font-family: var(--font-title);
    font-size: var(--little-text);
    font-style: italic;
    font-weight: 700;
    color: var(--color-accent);
    filter: var(--glow-accent);

    // Le symbole suit la couleur du nœud (éteint / allumé)
    :global(.thread-node-shape) {
      color: inherit;
    }

    &[data-label]::before {
      content: attr(data-label);
    }
  }

  @keyframes node-on {
    from {
      color: var(--color-decor-symbol);
      border-color: var(--color-border);
      filter: none;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      // Allumé quand son centre atteint le milieu de l'écran
      .thread-node:not(.lit-always) {
        animation: node-on linear both;
        animation-timeline: view();
        animation-range: cover calc(50vh - var(--node-size, 2.75rem) / 2) cover
          50vh;
      }
    }
  }
</style>
