---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import type { ProjectShape } from "../../content.config";

/**
 * NeonFrame — Image carrée découpée selon l'un des quatre symboles du site
 * (△ ○ × □), cernée d'un contour néon.
 *
 * Le triangle, le cercle et la croix découpent l'image (clip-path + contour
 * SVG aux mêmes points). Le carré la garde entière. La largeur est laissée au
 * parent (via `class`), la hauteur suit (carré).
 *
 * @prop {ImageMetadata} src       - Image importée.
 * @prop {string} alt              - Texte alternatif.
 * @prop {ProjectShape} shape      - Forme de la découpe.
 * @prop {number} size             - Côté de la plus grande image générée, en px
 *                                  (déclinée aussi en 50 % et 70 %).
 * @prop {string} sizes            - Largeur affichée (attribut `sizes`), pour
 *                                  que le navigateur choisisse la déclinaison.
 * @prop {"lazy" | "eager"} [loading] - Chargement de l'image (défaut : "lazy").
 * @prop {string} [class]          - Classes CSS additionnelles.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  shape: ProjectShape;
  size: number;
  sizes: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  src,
  alt,
  shape,
  size,
  sizes,
  loading = "lazy",
  class: className,
} = Astro.props;
---

<div class:list={["neon-frame", `neon-frame--${shape}`, className]}>
  <div class="neon-clip">
    <Image
      src={src}
      alt={alt}
      width={size}
      height={size}
      widths={[size * 0.5, size * 0.7, size]}
      sizes={sizes}
      loading={loading}
      class="neon-image"
    />
  </div>

  {
    shape === "triangle" && (
      <svg
        class="neon-outline"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <polygon points="0,0 100,0 50,100" vector-effect="non-scaling-stroke" />
      </svg>
    )
  }
  {
    shape === "circle" && (
      <svg class="neon-outline" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="50" cy="50" r="49" vector-effect="non-scaling-stroke" />
      </svg>
    )
  }
  {
    shape === "square" && (
      <svg
        class="neon-outline"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <rect
          x="1"
          y="1"
          width="98"
          height="98"
          vector-effect="non-scaling-stroke"
        />
      </svg>
    )
  }
  {
    shape === "cross" && (
      <svg
        class="neon-outline"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <polygon
          points="0,22 22,0 50,28 78,0 100,22 72,50 100,78 78,100 50,72 22,100 0,78 28,50"
          vector-effect="non-scaling-stroke"
        />
      </svg>
    )
  }
</div>

<style lang="scss">
  .neon-frame {
    position: relative;
    aspect-ratio: 1;
  }

  .neon-clip {
    width: 100%;
    height: 100%;
  }

  .neon-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .neon-outline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--color-text);
    stroke-width: 6;
    pointer-events: none;
    filter: var(--glow-neon-strong);
  }

  // Triangle inversé (pointe en bas)
  .neon-frame--triangle .neon-clip {
    clip-path: polygon(0% 0%, 100% 0%, 50% 100%);
  }

  // Le centre visuel du triangle (barycentre) est au tiers de sa hauteur :
  // agrandie de 4/3 depuis le bas, l'image y place son propre centre
  .neon-frame--triangle .neon-image {
    transform-origin: 50% 100%;
    scale: calc(4 / 3);
  }

  .neon-frame--circle .neon-clip {
    clip-path: circle(49%);
  }

  // Mêmes points que le polygone SVG du contour
  .neon-frame--cross .neon-clip {
    clip-path: polygon(
      0% 22%,
      22% 0%,
      50% 28%,
      78% 0%,
      100% 22%,
      72% 50%,
      100% 78%,
      78% 100%,
      50% 72%,
      22% 100%,
      0% 78%,
      28% 50%
    );
  }

  .neon-frame--square .neon-image {
    border: 1px solid var(--color-border);
  }
</style>
