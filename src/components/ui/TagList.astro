---
/**
 * TagList — Liste de tags techniques d'un projet.
 *
 * @prop {string[]} tags   - Libellés à afficher.
 * @prop {string} [class]  - Classes CSS additionnelles (espacement géré par le parent).
 */
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

<ul class:list={["tag-list", className]}>
  {tags.map((tag) => <li class="tag">{tag}</li>)}
</ul>

<style lang="scss">
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    background: rgba(0, 229, 239, 0.06);
    padding: 0.25rem 0.65rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(0, 229, 239, 0.1);
  }
</style>
