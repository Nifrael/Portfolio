---
/**
 * TagList — Liste de tags techniques d'un projet.
 *
 * Chaque techno connue a sa couleur (tokens `--color-tag-*`, insensible à
 * la casse) ; un tag inconnu retombe sur le cyan du site.
 *
 * @prop {string[]} tags   - Libellés à afficher.
 * @prop {string} [class]  - Classes CSS additionnelles (espacement géré par le parent).
 */
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

<ul class:list={["tag-list", className]}>
  {
    tags.map((tag) => (
      <li class="tag" data-tag={tag.toLowerCase()}>
        {tag}
      </li>
    ))
  }
</ul>

<style lang="scss">
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-s);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag {
    font-family: var(--font-text);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tag-color, var(--color-accent));
    background: color-mix(
      in srgb,
      var(--tag-color, var(--color-accent)) 6%,
      transparent
    );
    padding: var(--espace-xs) 0.65rem;
    border-radius: var(--rayon-s);
    border: 1px solid
      color-mix(in srgb, var(--tag-color, var(--color-accent)) 15%, transparent);
  }

  // Technos connues → token de couleur (sass est un alias de scss)
  $tag-colors: (
    "astro": "astro",
    "scss": "scss",
    "sass": "scss",
    "typescript": "typescript",
    "javascript": "javascript",
  );

  @each $tag, $token in $tag-colors {
    .tag[data-tag="#{$tag}"] {
      --tag-color: var(--color-tag-#{$token});
    }
  }
</style>
