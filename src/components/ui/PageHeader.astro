---
import ArrowLink from "./ArrowLink.astro";
import SectionTitle from "./SectionTitle.astro";

/**
 * PageHeader — En-tête des pages secondaires : lien de retour, titre de page
 * (h1) en deux lignes et sous-titre.
 *
 * @prop {string} outline       - Ligne du titre affichée en contour.
 * @prop {string} main          - Ligne du titre affichée en dégradé.
 * @prop {string} [backHref]    - Cible du lien de retour (défaut : "/").
 * @prop {string} [backLabel]   - Libellé du lien de retour (défaut : « Retour à l'accueil »).
 * @slot                        - Sous-titre (texte), masqué si absent.
 * @slot aside                  - Contenu affiché à droite dès le desktop
 *                                (sous le sous-titre en mobile), aligné en bas.
 */
interface Props {
  outline: string;
  main: string;
  backHref?: string;
  backLabel?: string;
}

const {
  outline,
  main,
  backHref = "/",
  backLabel = "Retour à l'accueil",
} = Astro.props;
---

<header class="page-header">
  <div class="page-header-main">
    <ArrowLink href={backHref} direction="left" muted>{backLabel}</ArrowLink>
    <SectionTitle as="h1" outline={outline} main={main} />
    {
      Astro.slots.has("default") && (
        <p class="page-subtitle">
          <slot />
        </p>
      )
    }
  </div>
  {
    Astro.slots.has("aside") && (
      <div class="page-header-aside">
        <slot name="aside" />
      </div>
    )
  }
</header>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .page-header {
    --title-size: clamp(2.5rem, 8vw, 5rem);

    display: flex;
    flex-direction: column;
    gap: var(--espace-l);
    margin-bottom: var(--espace-xl-plus);

    @include breakpoint-up($breakpoint-desktop) {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .page-header-main {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--espace-m-plus);
  }

  .page-subtitle {
    max-width: 35rem;
    margin: 0;
    font-family: var(--font-text);
    font-size: 1.1rem;
    font-weight: 200;
    line-height: 1.6;
    color: var(--color-text);
    opacity: 0.8;
  }
</style>
