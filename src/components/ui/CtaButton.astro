---
/**
 * CtaButton — Bouton d'appel à l'action unifié.
 *
 * @prop {string} href                        - URL de destination du lien.
 * @prop {string} label                       - Texte affiché dans le bouton.
 * @prop {"solid" | "outline"} [variant]      - Style du bouton (défaut : "solid").
 * @prop {boolean} [external]                 - Ouvre dans un nouvel onglet (target/rel),
 *                                              annoncé aux lecteurs d'écran.
 * @prop {boolean} [arrow]                    - Affiche une flèche animée au survol.
 * @prop {string} [class]                     - Classes CSS additionnelles.
 * @slot icon                                 - Icône affichée après le libellé.
 */
interface Props {
  href: string;
  label: string;
  variant?: "solid" | "outline";
  external?: boolean;
  arrow?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = "solid",
  external = false,
  arrow = false,
  class: className,
} = Astro.props;

const externalAttrs = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<a
  href={href}
  class:list={["cta", `cta--${variant}`, className]}
  {...externalAttrs}
>
  {label}
  <slot name="icon" />
  {
    arrow && (
      <span class="arrow" aria-hidden="true">
        →
      </span>
    )
  }
  {external && <span class="visually-hidden">(nouvel onglet)</span>}
</a>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--espace-s-plus);
    padding: var(--espace-m) var(--espace-m);
    font-family: var(--font-text);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      background-color 0.3s ease;

    .arrow {
      transition: transform 0.3s ease;
    }
  }

  .cta--solid {
    background: var(--color-accent);
    border: 1px solid var(--color-accent);
    color: var(--color-text-inversed);
    box-shadow:
      0 0 15px var(--color-accent-glow-l),
      0 0 40px var(--color-accent-glow-s);

    // Retour tactile au tap (mobile) et au clic maintenu (desktop)
    &:active {
      transform: scale(0.97);
      transition-duration: 0.1s;
    }

    @include breakpoint-up($breakpoint-desktop) {
      &:hover {
        transform: translateY(-2px);
        box-shadow:
          0 0 25px var(--color-accent-glow-xl),
          0 0 60px var(--color-accent-glow-m);
      }
    }
  }

  .cta--outline {
    background: transparent;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text);

    &:active {
      border-color: var(--color-accent);
      background-color: var(--color-accent);
      color: var(--color-text-inversed);
      transition-duration: 0.1s;

      .arrow {
        transform: translateX(4px);
      }
    }

    @include breakpoint-up($breakpoint-desktop) {
      &:hover {
        border-color: var(--color-accent);
        background-color: var(--color-accent);
        color: var(--color-text-inversed);
        box-shadow: 0 0 20px var(--color-accent-glow-m);

        .arrow {
          transform: translateX(4px);
        }
      }
    }
  }
</style>
