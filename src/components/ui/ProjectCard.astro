---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Github from "@assets/icons/Github.svg";
import ExternalLink from "@assets/icons/ExternalLink.svg";

interface Props {
  project: CollectionEntry<"projects">;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { title, description, tags, cover, links } = project.data;
---

<article class={`project-card ${featured ? 'featured' : ''}`}>
  <div class="project-image-wrapper">
    <Image
      src={cover.src}
      alt={cover.alt}
      width={800}
      height={450}
      class="project-image"
    />
  </div>

  <div class="project-info">
    <div class="project-tags">
      {tags.map((tag) => <span class="tag">{tag}</span>)}
    </div>

    {featured ? (
      <h3 class="project-card-title">{title}</h3>
    ) : (
      <h2 class="project-card-title">{title}</h2>
    )}
    
    <p class="project-description">{description}</p>

    <div class="project-footer">
      <a href={`/projects/${project.id}`} class="project-details-link">
        Détails
        <span class="arrow" aria-hidden="true">→</span>
      </a>

      {
        links && (
          <div class="project-links">
            {links.repository && (
              <a
                href={links.repository}
                target="_blank"
                rel="noopener noreferrer"
                class="project-icon-link"
                aria-label={`Code source de ${title}`}
              >
                <Github />
              </a>
            )}
            {links.live && (
              <a
                href={links.live}
                target="_blank"
                rel="noopener noreferrer"
                class="project-icon-link"
                aria-label={`Démonstration en direct de ${title}`}
              >
                <ExternalLink />
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</article>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .project-card {
    position: relative;
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid var(--border-surface);
    backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;

    // Coins décoratifs
    &::before,
    &::after {
      content: "";
      position: absolute;
      width: 0.5rem;
      height: 0.5rem;
      pointer-events: none;
      z-index: 1;
    }

    &::before {
      top: -1px;
      right: -1px;
      border-top: 2px solid var(--text-primary);
      border-right: 2px solid var(--text-primary);
    }

    &::after {
      bottom: -1px;
      left: -1px;
      border-bottom: 2px solid var(--text-primary);
      border-left: 2px solid var(--text-primary);
    }

    &:hover {
      border-color: rgba(0, 229, 239, 0.3);
      transform: translateY(-4px);
      box-shadow: 0 10px 30px rgba(0, 229, 239, 0.05);

      .project-image {
        transform: scale(1.02);
      }

      .project-image-wrapper::after {
        opacity: 0.1;
      }
    }
  }

  .project-image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);

    // Overlay d'image
    &::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--bg-base);
      opacity: 0.3;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-info {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    background: rgba(0, 229, 239, 0.06);
    padding: 0.25rem 0.65rem;
    border-radius: 0.25rem;
    border: 1px solid rgba(0, 229, 239, 0.1);
  }

  .project-card-title {
    font-family: var(--font-title);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 1rem 0;
    letter-spacing: -0.01em;
  }

  .project-description {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-primary);
    opacity: 0.7;
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .project-details-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.3s ease;

    .arrow {
      transition: transform 0.3s ease;
    }

    &:hover {
      color: var(--accent-primary);

      .arrow {
        transform: translateX(4px);
      }
    }
  }

  .project-links {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .project-icon-link {
    color: var(--text-primary);
    opacity: 0.6;
    transition:
      color 0.3s ease,
      opacity 0.3s ease,
      transform 0.2s ease;

    &:hover {
      color: var(--accent-primary);
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  // Styles spécifiques pour la version "Featured" (horizontale)
  .project-card.featured {
    @include breakpoint-up($breakpoint-tablet) {
      width: 80%;
      max-height: 70vh;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 3fr;

      &:hover {
        .project-image {
          transform: scale(1.01);
        }
      }
    }

    .project-image-wrapper {
      @include breakpoint-up($breakpoint-tablet) {
        aspect-ratio: auto;
        height: 100%;
        border-bottom: none;
      }
    }
  }
</style>
