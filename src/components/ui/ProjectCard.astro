---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import TagList from "@components/ui/TagList.astro";
import ArrowLink from "@components/ui/ArrowLink.astro";
import ProjectLinks from "@components/ui/ProjectLinks.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, tags, cover, links } = project.data;
---

<article class="project-card">
  <div class="project-image-wrapper">
    <Image
      src={cover.src}
      alt={cover.alt}
      width={800}
      height={450}
      class="project-image"
    />
  </div>

  <div class="project-info">
    <TagList tags={tags} class="project-card-tags" />

    <h2 class="project-card-title">{title}</h2>

    <p class="project-description">{description}</p>

    <div class="project-footer">
      <ArrowLink href={`/projets/${project.id}`}>Détails</ArrowLink>
      <ProjectLinks links={links} title={title} />
    </div>
  </div>
</article>

<style lang="scss">
  @use "@styles/config/variables" as *;
  @use "@styles/config/mixin" as *;

  .project-card {
    position: relative;
    background: var(--color-bg-cards);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;

    @include breakpoint-up($breakpoint-desktop) {
      &:hover {
        border-color: var(--color-accent-border);
        transform: translateY(-4px);
        box-shadow: 0 10px 30px var(--color-accent-glow-xs);

        .project-image {
          transform: scale(1.02);
        }

        .project-image-wrapper::after {
          opacity: 0.1;
        }
      }
    }
  }

  .project-image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-subtle);

    // Overlay d'image
    &::after {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--color-bg-primary);
      opacity: 0.3;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .project-info {
    padding: var(--espace-l);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  // :global() requis : la classe est portée par le composant enfant TagList,
  // qui ne reçoit pas l'attribut de scope de ce composant.
  .project-info :global(.project-card-tags) {
    margin-bottom: var(--espace-m);
  }

  .project-card-title {
    font-family: var(--font-title);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 var(--espace-m) 0;
    letter-spacing: -0.01em;
  }

  .project-description {
    font-family: var(--font-text);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text);
    opacity: 0.7;
    margin: 0 0 var(--espace-l) 0;
    flex-grow: 1;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: var(--espace-m-plus);
    border-top: 1px solid var(--color-border-subtle);
  }
</style>
