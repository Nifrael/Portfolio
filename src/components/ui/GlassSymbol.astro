---
/**
 * GlassSymbol — Symbole décoratif sur fond verre dépoli.
 *
 * La taille du glyphe se règle via la custom property `--symbol-size`
 * (défaut : 2rem), le positionnement est laissé au parent.
 *
 * @prop {string} symbol   - Caractère affiché.
 * @prop {string} [class]  - Classes CSS additionnelles.
 */
interface Props {
  symbol: string;
  class?: string;
}

const { symbol, class: className } = Astro.props;
---

<div class:list={["glass-symbol", className]}>
  <span>{symbol}</span>
</div>

<style lang="scss">
  .glass-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1.5rem;
    backdrop-filter: blur(12px);

    span {
      font-family: var(--font-body);
      font-size: var(--symbol-size, 2rem);
      color: rgba(255, 255, 255, 0.3);
    }
  }
</style>
